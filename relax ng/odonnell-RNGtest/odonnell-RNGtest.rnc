#2026 Relax NG Test - Colin O'Donnell
start = xml
#1. Changed "|" to ",". It's an order not one OR the other. - CRO
xml = element xml { heading, body }
heading = element heading {title, byline, listNames}
#2. Changed {empty} to {text}
title = element title {text}
#3. Added mixed 
byline = element byline {mixed{author, pubTitle, date}}
author = element author {text}
pubTitle = element pubTitle {text}
#4. org is missing a + next to it like the others. 
listNames = element listNames {person+, org+, tech+}
person = element person {role, id, name}
org = element org {role, id, name}
tech = element tech {role, id, name, source}
#5. changed element role to attribute role
role = attribute role {"investigator" | "navigator" | "pilot" | "search" | "flight" | "research"| "news"}
#6. Changed {??} to {xsd:ID} how I did in the pretest
id = attribute id {xsd:ID}
name = element name {text}
source = element source {url, empty}
#7. Changed {??} to {xsd:anyURI}
url = attribute url {xsd:anyURI}
#8. Body needs an intro, and section I added a + because there's more.
body = element body { intro, section+ }
intro = element intro {p+}
#9. p element needs a + because there's more than 1
section = element section {subtitle, p+}
#10. Subtitle was missing a section so I added one
subtitle = element subtitle { text }
#11. added mixed ttag and got rid of extra {text}
p = element p {mixed{(timelapse | date | place | mention | radioFreq | message)*}}
radioFreq = element radioFreq {text}
#12. Added dur next to text and a duration element
timelapse = element timelapse {dur, text}
dur = attribute dur {text}
#13. when needs a "?"
date = element date { when?, from?, to?, text}
#14. Added when, from and to to fit all possibilities from the xml 
when = attribute when {text}
from = attribute from {text}
to = attribute to {text}
place = element place {text}
mention = element mention {ref, text}
ref = attribute ref {xsd:IDREF}
#15. added type? for 0-1
message = element message {type?, text}
type = attribute type {text}